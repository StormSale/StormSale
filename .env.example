# Backend API URL (for legacy backend calls)
VITE_API_URL=http://localhost:3000/api

# Sentry error tracking (optional)
# When empty, error tracking stays completely disabled and no data is sent.
# The DSN is a public client value, not a secret.
VITE_SENTRY_DSN=

# Stellar Network Configuration
VITE_STELLAR_NETWORK=TESTNET
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Smart Contract Deployment ID (Soroban Testnet)
VITE_STORMSALE_CONTRACT_ID=

# Server-Side / CI Platform Auditor Key for Automated SOC 2 Type II Evidence Packaging
# Ed25519 Secret Key (Stellar format S... or 64-char hex string)
# Used to sign evidence manifests, root digests, and verification receipts in backend/CI jobs.
# Never expose this private key to browser bundles.
# Generate a new keypair using: node scripts/generate-auditor-key.mjs
AUDITOR_PRIVATE_KEY=

# Configured Authorized Auditor Public Keys (comma-separated Stellar G... public keys)
# Used by verifiers to pin trusted compliance auditors and reject unauthorized signatures.
VITE_AUTHORIZED_AUDITOR_KEYS=


# Sanctions screening (OFAC / Chainalysis)
# Comma-separated Stellar addresses to always block
VITE_SANCTIONED_ADDRESSES=
# Optional Chainalysis sanctions screening API key
VITE_CHAINALYSIS_API_KEY=
# Remediation contact shown in the compliance warning
VITE_COMPLIANCE_CONTACT=

# ── Upstash Redis (Custom Short-Link Shared Store) ────────────────────────────
# Required for the /api/custom-links/* and /api/affiliate/click-stream Vercel
# serverless functions (the click stream keeps only country ISO codes, never IPs).
# Provision a free Upstash Redis database at:
#   https://vercel.com/marketplace?category=storage&search=redis
# OR directly at: https://console.upstash.com
# Then add these values to Vercel's Environment Variables dashboard
# (Settings → Environment Variables) and to your local .env.local for dev.
#
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Telegram Commission Alerts (/api/telegram/*) ─────────────────────────────
# Server-only: never prefix these with VITE_, so they stay out of the bundle.
# TELEGRAM_BOT_TOKEN comes from @BotFather for @StormSaleBot. Register the
# webhook with the same secret Telegram will echo back on every update:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#     -d url=https://<host>/api/telegram/webhook -d secret_token=$TELEGRAM_WEBHOOK_SECRET
# Alerts also need the Upstash Redis variables above.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# StormSale contract whose log_sale transactions trigger alerts, and the Soroban
# RPC/network used to confirm them (fall back to the VITE_ values when unset).
STORMSALE_CONTRACT_ID=
STELLAR_RPC_URL=
STELLAR_NETWORK_PASSPHRASE=
