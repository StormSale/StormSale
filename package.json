{
  "name": "storm-sale",
  "version": "1.0.0",
  "private": true,
  "description": "\tThe future of affiliate bridging the gap between marketers and end users",
  "homepage": "https://github.com/StormSale/StormSale#readme",
  "bugs": {
    "url": "https://github.com/StormSale/StormSale/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StormSale/StormSale.git"
  },
  "license": "MIT",
  "author": "Jibril Raji Qasim (AJDEV)",
  "type": "module",
  "main": "eslint.config.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node scripts/check-coverage.cjs",
    "security:check": "node scripts/check-security-headers.cjs",
    "security:malware": "node scripts/malware-scanner.cjs",
    "release": "semantic-release",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium firefox webkit",
    "preview": "vite preview",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ledgerhq/hw-app-str": "^7.8.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@sentry/react": "^11.8.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "buffer": "^6.0.3",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "jszip": "^3.10.2",
    "lit": "^3.3.1",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.16",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^24.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.5.1",
    "semantic-release": "^25.0.9",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
