diff --git a/api/performance/vitals.ts b/api/performance/vitals.ts
new file mode 100644
index 0000000..b6c8ce5
--- /dev/null
+++ b/api/performance/vitals.ts
@@ -0,0 +1,68 @@
+/**
+ * POST /api/performance/vitals
+ *
+ * Receives Core Web Vitals reports sent with `navigator.sendBeacon` by the
+ * client collector (issue #502). Beacons arrive as `application/json` blobs, or
+ * as `text/plain` on browsers that downgrade the content type.
+ *
+ * Body: { name: "LCP" | "FID" | "CLS", value: number, rating, delta, id,
+ *         navigationType, path, timestamp }
+ *
+ * Responses:
+ *   204 No Content — report accepted
+ *   400            — { error: string } (invalid payload)
+ *   405            — Method Not Allowed
+ */
+import type { VercelRequest, VercelResponse } from "@vercel/node";
+
+const NAMES = new Set(["LCP", "FID", "CLS"]);
+const RATINGS = new Set(["good", "needs-improvement", "poor"]);
+/** Upper bounds that reject nonsense values (LCP/FID in ms, CLS unitless). */
+const MAX_VALUE: Record<string, number> = { LCP: 600_000, FID: 600_000, CLS: 100 };
+
+export interface ValidVitalPayload {
+  name: string;
+  value: number;
+  rating: string;
+  id: string;
+  path: string;
+}
+
+export function validateVitalPayload(input: unknown): ValidVitalPayload | null {
+  if (!input || typeof input !== "object") return null;
+  const b = input as Record<string, unknown>;
+  if (typeof b.name !== "string" || !NAMES.has(b.name)) return null;
+  if (typeof b.value !== "number" || !Number.isFinite(b.value)) return null;
+  if (b.value < 0 || b.value > MAX_VALUE[b.name]) return null;
+  if (typeof b.rating !== "string" || !RATINGS.has(b.rating)) return null;
+  if (typeof b.id !== "string" || b.id.length === 0 || b.id.length > 100) return null;
+  const path = typeof b.path === "string" ? b.path.slice(0, 200) : "/";
+  return { name: b.name, value: b.value, rating: b.rating, id: b.id, path };
+}
+
+function parseBody(body: unknown): unknown {
+  if (typeof body === "string") {
+    try {
+      return JSON.parse(body);
+    } catch {
+      return null;
+    }
+  }
+  return body;
+}
+
+export default async function handler(req: VercelRequest, res: VercelResponse) {
+  if (req.method !== "POST") {
+    res.setHeader("Allow", "POST");
+    return res.status(405).json({ error: "Method Not Allowed" });
+  }
+
+  const payload = validateVitalPayload(parseBody(req.body));
+  if (!payload) {
+    return res.status(400).json({ error: "Invalid web vitals payload." });
+  }
+
+  // Structured log line; Vercel log drains can aggregate these per metric.
+  console.info("[web-vitals]", JSON.stringify(payload));
+  return res.status(204).end();
+}
